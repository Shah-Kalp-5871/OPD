# MedFlow OPD — Staging Environment
# =============================================================================
# Mirror of production but with staging DB, less strict limits
# =============================================================================

NODE_ENV=production
PORT=3001

DATABASE_URL=postgresql://medflow_staging:<STAGING_DB_PASS>@postgres:5432/medflow_staging?schema=public
POSTGRES_DB=medflow_staging
POSTGRES_USER=medflow_staging
POSTGRES_PASSWORD=<STAGING_DB_PASS>

JWT_SECRET=<STAGING_JWT_SECRET_MIN_48_CHARS>
JWT_EXPIRES_IN=8h

CORS_ORIGIN=https://staging.<YOUR_DOMAIN>

NEXT_PUBLIC_API_URL=/api

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<STAGING_REDIS_PASSWORD>

UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=<MAILTRAP_USER>
SMTP_PASS=<MAILTRAP_PASS>
SMTP_FROM="MedFlow Staging <staging@yourclinic.com>"

LOG_LEVEL=info
LOG_FORMAT=json
