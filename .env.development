# MedFlow OPD — Development Environment
# =============================================================================
# Safe for local development. NEVER use these credentials in production.
# =============================================================================

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:kalp%40123@localhost:5432/opd_db?schema=public

POSTGRES_DB=opd_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=kalp@123

# Dev JWT secret — weak on purpose for easy debugging
JWT_SECRET=dev-local-jwt-secret-key-not-for-production-32chars
JWT_EXPIRES_IN=24h

CORS_ORIGIN=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:3001/api

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MedFlow Dev <dev@localhost>"

LOG_LEVEL=debug
LOG_FORMAT=pretty

# Meta WhatsApp Cloud API Credentials
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=secret_placeholder
RAZORPAY_WEBHOOK_SECRET=webhook_secret
