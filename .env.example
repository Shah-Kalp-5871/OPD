# MedFlow Environment Configuration Template

# Runtime Environment (development, production, test)
NODE_ENV=production

# Server Port
PORT=3001

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://medflow:your_secure_password@localhost:5432/medflow_db?schema=public

# Security: JWT Secret (Minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=YOUR_PRODUCTION_SECURE_JWT_SECRET_KEY_MIN_32_CHARS

# Frontend URL for CORS
CORS_ORIGIN=https://medflow.yourclinic.com

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Optional: SMTP for Notifications (Future)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASS=

# Optional: SSL Config (If not using Reverse Proxy like Nginx)
# SSL_KEY_PATH=/path/to/key.pem
# SSL_CERT_PATH=/path/to/cert.pem
