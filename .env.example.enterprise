# =============================================================================
# MedFlow OPD — Enterprise Environment Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example.enterprise .env.production
#   2. Fill in ALL values marked with <REPLACE_THIS>
#   3. NEVER commit .env.production to version control
#   4. Generate JWT_SECRET: openssl rand -base64 48
#   5. Generate REDIS_PASSWORD: openssl rand -base64 32
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# In Docker: HOST = postgres (service name)
# On bare metal: HOST = localhost or your DB server IP
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=public

# Separate vars for Docker Compose postgres service
POSTGRES_DB=medflow_db
POSTGRES_USER=medflow
POSTGRES_PASSWORD=<REPLACE_THIS_STRONG_PASSWORD>

# ── Security ─────────────────────────────────────────────────────────────────
# CRITICAL: Must be 48+ characters. Generate: openssl rand -base64 48
JWT_SECRET=<REPLACE_THIS_MINIMUM_48_CHAR_RANDOM_STRING>
JWT_EXPIRES_IN=8h

# ── CORS ─────────────────────────────────────────────────────────────────────
# Your public domain — must match exactly what browsers send
CORS_ORIGIN=https://<YOUR_DOMAIN>

# ── Frontend ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ vars are baked into the Next.js bundle at build time
# For Docker: use relative /api path (Nginx routes it to backend)
# For direct access: full backend URL
NEXT_PUBLIC_API_URL=/api

# ── Redis ────────────────────────────────────────────────────────────────────
# In Docker: HOST = redis (service name)
# On bare metal: HOST = localhost
REDIS_HOST=redis
REDIS_PORT=6379
# CRITICAL: Set a strong password. Generate: openssl rand -base64 32
REDIS_PASSWORD=<REPLACE_THIS_STRONG_REDIS_PASSWORD>

# ── File Storage ─────────────────────────────────────────────────────────────
# In Docker: use absolute path — mounted as volume
UPLOAD_DIR=/app/uploads
# 10MB in bytes
MAX_FILE_SIZE=10485760

# ── SMTP / Email ─────────────────────────────────────────────────────────────
# For OTP delivery and notification emails
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourclinic.com
SMTP_PASS=<REPLACE_THIS_SMTP_PASSWORD>
SMTP_FROM="MedFlow Clinic <noreply@yourclinic.com>"

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=MedFlow OPD System
APP_URL=https://<YOUR_DOMAIN>/opd
CLINIC_NAME=<YOUR_CLINIC_NAME>

# ── OTP Settings ─────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=warn
LOG_FORMAT=json
