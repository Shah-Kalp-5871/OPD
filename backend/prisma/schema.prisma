// ─── Phase 19: AI & Clinical Intelligence Models ───────────────────────────

/// Immutable audit trail for every AI suggestion displayed to a clinician.
/// Doctors may accept, modify, or reject — all outcomes are recorded.
model AiSuggestionLog {
  id              String    @id @default(uuid())
  /// Which module generated this suggestion
  moduleType      String // CLINICAL_DECISION, DRUG_INTERACTION, ALLERGY_CHECK, RISK_ENGINE, INVENTORY_FORECAST, ANOMALY_DETECTION
  /// Context entity (caseId, patientId, inventoryId, etc.)
  entityType      String
  entityId        String
  /// The raw input that triggered the suggestion
  inputContext    Json
  /// The AI-generated suggestions (array of recommendation objects)
  suggestions     Json
  /// Confidence score 0-100
  confidenceScore Int       @default(0)
  /// Doctor action on the suggestion
  outcome         String    @default("SHOWN") // SHOWN, ACCEPTED, MODIFIED, REJECTED, IGNORED
  /// The user who saw/acted on the suggestion
  reviewedById    String?
  reviewedAt      DateTime?
  /// Optional notes from the reviewing clinician
  reviewNotes     String?
  branchId        String?
  createdAt       DateTime  @default(now())

  @@index([moduleType, entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([branchId])
}

/// Patient-level risk flags generated by the Clinical Risk Engine.
model ClinicalRiskFlag {
  id               String    @id @default(uuid())
  patientId        String
  branchId         String
  /// Type of risk detected
  riskType         String // ABNORMAL_VITALS, CRITICAL_LAB, REPEAT_EMERGENCY, CHRONIC_DISEASE, DRUG_INTERACTION, ALLERGY_CONFLICT, HIGH_REFUND
  /// Severity: MILD | MODERATE | SEVERE | CRITICAL
  severity         Severity  @default(MODERATE)
  /// Human-readable description of the risk
  description      String
  /// Structured details (threshold values, detected values, etc.)
  details          Json?
  /// Whether a clinician has acknowledged this flag
  isAcknowledged   Boolean   @default(false)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  /// When this flag expires (for transient risks)
  expiresAt        DateTime?
  isResolved       Boolean   @default(false)
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([patientId, isResolved])
  @@index([branchId, severity])
  @@index([riskType])
  @@index([createdAt])
}

/// Operational anomaly alerts generated by the Enterprise Intelligence Engine.
model OperationalAnomaly {
  id           String    @id @default(uuid())
  branchId     String
  /// Category of anomaly
  anomalyType  String // SUSPICIOUS_BILLING, UNUSUAL_REFUND, STOCK_ADJUSTMENT, REVENUE_DROP, HIGH_FOC
  /// Anomaly score 0-100 (higher = more suspicious)
  anomalyScore Int       @default(0)
  /// Human-readable description
  description  String
  /// Structured evidence data
  evidence     Json?
  /// Whether this anomaly was reviewed
  status       String    @default("OPEN") // OPEN, REVIEWED, DISMISSED, ESCALATED
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([branchId, status])
  @@index([anomalyType])
  @@index([anomalyScore])
  @@index([createdAt])
}

