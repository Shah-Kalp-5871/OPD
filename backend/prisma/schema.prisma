// ─── Phase 21: Digital Healthcare Ecosystem ──────────────────────────────────

/// Tracks the metadata of a WebRTC Telemedicine consultation session. No video PHI is stored.
model TelemedicineSessionLog {
  id              String    @id @default(uuid())
  sessionId       String    @unique
  caseId          String
  doctorId        String
  patientId       String
  startTime       DateTime  @default(now())
  endTime         DateTime?
  durationSeconds Int       @default(0)
  disconnects     Int       @default(0)
  qualityMetrics  Json? // Stores bandwidth, latency, resolution degradation info
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  case    PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  doctor  User        @relation(fields: [doctorId], references: [id])
  patient Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([caseId])
  @@index([doctorId])
  @@index([patientId])
}

/// Tracks external payment intents from gateways like Stripe or Razorpay.
model PaymentIntent {
  id            String   @id @default(uuid())
  provider      String // STRIPE, RAZORPAY
  providerId    String   @unique // e.g., pi_123 or order_abc
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR")
  status        String   @default("REQUIRES_PAYMENT_METHOD") // REQUIRES_PAYMENT_METHOD, SUCCEEDED, FAILED
  billId        String?  @unique
  appointmentId String?  @unique
  patientId     String
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bill        Bill?        @relation(fields: [billId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
  @@index([patientId])
}

/// Idempotency table for webhook event processing
model WebhookEvent {
  id        String   @id @default(uuid())
  provider  String // STRIPE, RAZORPAY
  eventId   String   @unique
  eventType String
  status    String   @default("PROCESSED") // PROCESSED, FAILED
  payload   Json?
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([provider, eventType])
}

/// Append-only audit ledger tracking payment transactions. Immutable.
model PaymentAuditLog {
  id              String   @id @default(uuid())
  paymentIntentId String
  oldStatus       String?
  newStatus       String
  actor           String?
  webhookSource   String?
  correlationId   String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([paymentIntentId])
  @@index([correlationId])
  @@index([createdAt])
}

model DeviceToken {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  platform     String // ANDROID, IOS, WEB
  deviceType   String?
