generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String               @id @default(uuid())
  name                   String
  email                  String               @unique
  password               String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  isActive               Boolean              @default(true)
  role                   Role
  mobile                 String?
  deletedAt              DateTime?
  failedLoginAttempts    Int                  @default(0)
  firstName              String?
  lastLoginAt            DateTime?
  lastName               String?
  lockedUntil            DateTime?
  passwordHash           String?
  activityLogs           ActivityLog[]
  adminProfile           AdminProfile?
  auditLogs              AuditLog[]
  authorizedDevices      AuthorizedDevice[]
  createdBills           Bill[]               @relation("BillCreatedBy")
  collectedPayments      BillPayment[]        @relation("CollectedPayments")
  clinicalImages         ClinicalImage[]
  doctorConsultations    ConsultationRecord[] @relation("DoctorConsultations")
  doctorProfile          DoctorProfile?
  loginHistory           LoginHistory[]
  medicalProfile         MedicalProfile?
  nurseProfile           NurseProfile?
  createdPatients        Patient[]            @relation("PatientCreatedBy")
  doctorCases            PatientCase[]
  vitalsTaken            PatientVitals[]
  assignedQueues         QueueEntry[]
  performedActions       QueueHistory[]
  receptionProfile       ReceptionProfile?
  staffProfile           StaffProfile?
  userSessions           UserSession[]
  doctorSessions         VisitSession[]
  consultationsUpdated   ConsultationRecord[] @relation("ConsultationUpdatedBy")
  consultationsFinalized ConsultationRecord[] @relation("ConsultationFinalizedBy")
  investigationFiles     InvestigationFile[]
  processedRefunds       BillRefund[]         @relation("ProcessedRefunds")
  finalizedBills         Bill[]               @relation("BillFinalizedBy")
  stockMovements         StockMovement[]
  transfersRequested     StockTransfer[]      @relation("TransfersRequested")
  transfersApproved      StockTransfer[]      @relation("TransfersApproved")
  transfersDispatched    StockTransfer[]      @relation("TransfersDispatched")
  transfersReceived      StockTransfer[]      @relation("TransfersReceived")
  communicationLogs      CommunicationLog[]
  inAppNotifications     InAppNotification[]
  primaryBranchId        String?
  branchAccess           UserBranchAccess[]
}

model AdminProfile {
  id     String  @id @default(uuid())
  userId String  @unique
  notes  String?
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReceptionProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  overtimeRate Decimal @default(0.0) @db.Decimal(10, 2)
  salary       Decimal @default(0.0) @db.Decimal(10, 2)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorProfile {
  id              String           @id @default(uuid())
  userId          String           @unique
  specialization  String?
  consultationFee Decimal          @default(0.0) @db.Decimal(10, 2)
  licenseNumber   String?          @unique
  appointmentGap  Int              @default(10)
  availableDays   String[]         @default([])
  eveningEnd      String?
  eveningStart    String?
  morningEnd      String?
  morningStart    String?
  slotDuration    Int              @default(15)
  departmentId    String?
  appointments    Appointment[]
  department      Department?      @relation(fields: [departmentId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules       DoctorSchedule[]
  leaves          DoctorLeave[]
  blockedSlots    DoctorBlockedSlot[]
}

model NurseProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  department   String?
  overtimeRate Decimal @default(0.0) @db.Decimal(10, 2)
  salary       Decimal @default(0.0) @db.Decimal(10, 2)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MedicalProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  isPharmacist Boolean @default(false)
  overtimeRate Decimal @default(0.0) @db.Decimal(10, 2)
  salary       Decimal @default(0.0) @db.Decimal(10, 2)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StaffProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  employeeCode String?  @unique
  designation  String?
  baseSalary   Decimal  @default(0.0) @db.Decimal(10, 2)
  overtimeRate Decimal  @default(0.0) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Patient {
  id                      String             @id @default(uuid())
  mrdNumber               String             @unique
  firstName               String
  middleName              String?
  lastName                String
  mobile                  String             @unique
  gender                  String
  profileCompletionStatus Int                @default(20)
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  createdById             String?
  deletedAt               DateTime?
  email                   String?
  genderEnum              Gender             @default(UNKNOWN)
  isFoc                   Boolean            @default(false)
  preferredLanguage       String             @default("English")
  appointments            Appointment[]
  bills                   Bill[]
  createdBy               User?              @relation("PatientCreatedBy", fields: [createdById], references: [id])
  addresses               PatientAddress[]
  allergiesList           PatientAllergy[]
  cases                   PatientCase[]
  documents               PatientDocument[]
  flags                   PatientFlag[]
  guardians               PatientGuardian[]
  historyRecord           PatientHistory?
  insurance               PatientInsurance[]
  notes                   PatientNote[]
  profile                 PatientProfile?
  vitals                  PatientVitals[]
  queueEntries            QueueEntry[]
  communicationLogs       CommunicationLog[]
  auth                    PatientAuth?

  @@index([firstName, lastName])
  @@index([createdAt])
  @@index([isActive])
}

model PatientProfile {
  id                   String        @id @default(uuid())
  patientId            String        @unique
  dob                  DateTime?
  age                  Int?
  bloodGroup           String?
  address              String?
  city                 String?
  state                String?
  occupation           String?
  maritalStatus        String?
  allergies            String?
  emergencyContact     String?
  notes                String?
  photo                String?
  bloodGroupEnum       BloodGroup    @default(UNKNOWN)
  emergencyContactName String?
  emergencyContactNo   String?
  maritalStatusEnum    MaritalStatus @default(SINGLE)
  patient              Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientVitals {
  id            String       @id @default(uuid())
  patientId     String
  caseId        String?
  height        Float?
  weight        Float?
  bmi           Float?
  bloodPressure String?
  pulse         Int?
  temperature   Float?
  spo2          Int?
  takenById     String?
  takenAt       DateTime     @default(now())
  patientCase   PatientCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  takenBy       User?        @relation(fields: [takenById], references: [id])
  branchId      String
  branch        Branch       @relation("BranchVitals", fields: [branchId], references: [id])
}

model PatientCase {
  id                  String               @id @default(uuid())
  caseNumber          String
  patientId           String
  doctorId            String?
  visitType           String?
  priority            String               @default("NORMAL")
  complaint           String?
  visitDate           DateTime             @default(now())
  status              String               @default("OPEN")
  stage               CaseStage            @default(RECEPTION)
  createdAt           DateTime             @default(now())
  checkInTime         DateTime?
  closeTime           DateTime?
  priorityEnum        CasePriority         @default(NORMAL)
  updatedAt           DateTime             @default(now()) @updatedAt
  appointment         Appointment?
  bill                Bill?
  billsList           Bill[]               @relation("CaseBillsList")
  notes               CaseNote[]
  statusHistory       CaseStatusHistory[]
  tags                CaseTag[]
  clinicalImages      ClinicalImage[]
  consultation        ConsultationRecord?
  followups           Followup[]
  investigationOrders InvestigationOrder[]
  doctor              User?                @relation(fields: [doctorId], references: [id])
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vitalsList          PatientVitals[]
  prescriptions       Prescription[]
  procedureSessions   ProcedureSession[]
  queueEntry          QueueEntry?
  sessions            VisitSession[]
  branchId            String
  branch              Branch               @relation("BranchCases", fields: [branchId], references: [id])

  @@unique([caseNumber, branchId])
}

model QueueEntry {
  id           String         @id @default(uuid())
  tokenDisplay String
  tokenNumber  Int
  queueType    QueueType      @default(OPD)
  status       QueueStatus    @default(WAITING)
  priority     String         @default("NORMAL")
  caseId       String         @unique
  patientId    String
  doctorId     String?
  checkInTime  DateTime       @default(now())
  callCount    Int            @default(0)
  expectedTime DateTime?
  updatedAt    DateTime       @default(now()) @updatedAt
  calls        QueueCall[]
  case         PatientCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  doctor       User?          @relation(fields: [doctorId], references: [id])
  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  history      QueueHistory[]
  branchId     String
  branch       Branch         @relation("BranchQueue", fields: [branchId], references: [id])

  @@unique([tokenDisplay, branchId])
  @@index([status, checkInTime])
}

model VisitSession {
  id           String              @id @default(uuid())
  caseId       String
  doctorId     String
  startTime    DateTime            @default(now())
  endTime      DateTime?
  status       String              @default("ACTIVE")
  consultation ConsultationRecord?
  case         PatientCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  doctor       User                @relation(fields: [doctorId], references: [id])
  branchId     String
  branch       Branch              @relation("BranchSessions", fields: [branchId], references: [id])
}

model QueueHistory {
  id            String       @id @default(uuid())
  queueEntryId  String
  action        String
  fromStatus    QueueStatus?
  toStatus      QueueStatus
  performedById String
  timestamp     DateTime     @default(now())
  performedBy   User         @relation(fields: [performedById], references: [id])
  queueEntry    QueueEntry   @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
}

model Bill {
  id                String        @id @default(uuid())
  billNumber        String
  caseId            String        @unique
  patientId         String
  grossAmount       Decimal       @default(0.0) @db.Decimal(10, 2)
  discountTotal     Decimal       @default(0.0) @db.Decimal(10, 2)
  netAmount         Decimal       @default(0.0) @db.Decimal(10, 2)
  paidAmount        Decimal       @default(0.0) @db.Decimal(10, 2)
  balanceAmount     Decimal       @default(0.0) @db.Decimal(10, 2)
  paymentStatus     String        @default("PENDING")
  paymentMode       String?
  transactionId     String?
  billingDate       DateTime      @default(now())
  paidAt            DateTime?
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  patientCaseId     String?
  paymentStatusEnum BillStatus    @default(PENDING)
  isFinalized       Boolean       @default(false)
  finalizedAt       DateTime?
  finalizedById     String?
  case              PatientCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy         User?         @relation("BillCreatedBy", fields: [createdById], references: [id])
  finalizedBy       User?         @relation("BillFinalizedBy", fields: [finalizedById], references: [id])
  patientCase       PatientCase?  @relation("CaseBillsList", fields: [patientCaseId], references: [id])
  patient           Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items             BillItem[]
  payments          BillPayment[]
  refunds           BillRefund[]
  branchId          String
  branch            Branch        @relation("BranchBills", fields: [branchId], references: [id])

  @@unique([billNumber, branchId])
  @@index([paymentStatusEnum, billingDate])
  @@index([caseId])
  @@index([finalizedAt])
  @@index([finalizedById])
}

model BillItem {
  id                 String   @id @default(uuid())
  billId             String
  serviceName        String
  description        String?
  quantity           Int      @default(1)
  unitPrice          Decimal  @default(0.0) @db.Decimal(10, 2)
  discount           Decimal  @default(0.0) @db.Decimal(10, 2)
  totalPrice         Decimal  @default(0.0) @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  itemType           String?
  procedureSessionId String?
  referenceId        String?
  branchId           String
  branch             Branch               @relation("BranchBillItems", fields: [branchId], references: [id])
  bill               Bill                 @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model ConsultationRecord {
  id                   String             @id @default(uuid())
  caseId               String             @unique
  sessionId            String?            @unique
  doctorId             String
  status               String             @default("DRAFT")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  statusEnum           ConsultationStatus @default(DRAFT)
  provisionalDiagnosis String?
  finalDiagnosis       String?
  treatmentPlan        String?
  advice               String?
  nextVisitDate        DateTime?          @db.Date
  finalizedAt          DateTime?
  isFinalized          Boolean            @default(false)
  updatedById          String?
  finalizedById        String?
  history              ClinicalHistory?
  complaint            ComplaintEntry?
  case                 PatientCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  doctor               User               @relation("DoctorConsultations", fields: [doctorId], references: [id])
  session              VisitSession?      @relation(fields: [sessionId], references: [id])
  updatedBy            User?              @relation("ConsultationUpdatedBy", fields: [updatedById], references: [id])
  finalizedBy          User?              @relation("ConsultationFinalizedBy", fields: [finalizedById], references: [id])
  branchId             String
  branch               Branch             @relation("BranchConsultations", fields: [branchId], references: [id])
}

model ComplaintEntry {
  id                 String             @id @default(uuid())
  consultationId     String             @unique
  chiefComplaint     String?
  duration           Int?
  durationType       String?
  severity           String?
  onset              String?
  aggravatingFactors String?
  relievingFactors   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  presentIllness     String?
  consultation       ConsultationRecord @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

model ClinicalHistory {
  id               String             @id @default(uuid())
  consultationId   String             @unique
  pastHistory      String?
  personalHistory  String?
  surgicalHistory  String?
  familyHistory    String?
  obstetricHistory String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  allergies        String?
  chronicDiseases  String?
  consultation     ConsultationRecord @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthorizedDevice {
  id         String    @id @default(uuid())
  userId     String
  deviceUuid String    @unique
  deviceName String?
  isTrusted  Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id          String   @id @default(uuid())
  userId      String
  ipAddress   String?
  userAgent   String?
  status      String
  attemptedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id        String   @id @default(uuid())
  mobile    String
  otp       String
  purpose   String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([mobile])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  entityType String
  entityId   String
  action     String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  details    String?
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Clinic {
  id             String          @id @default(uuid())
  name           String
  registrationNo String?
  taxId          String?
  logoUrl        String?
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  country        String?
  zipCode        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branches       Branch[]
  settings       ClinicSetting[]
}

model Branch {
  id           String        @id @default(uuid())
  clinicId     String
  name         String
  branchCode   String        @unique
  address      String?
  phone        String?
  timezone     String        @default("UTC")
  contactEmail String?
  settings     Json?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  departments  Department[]
  rooms        Room[]
  patientCases PatientCase[] @relation("BranchCases")
  queueEntries QueueEntry[]  @relation("BranchQueue")
  bills        Bill[]        @relation("BranchBills")
  appointments Appointment[] @relation("BranchAppointments")
  sessions     VisitSession[] @relation("BranchSessions")
  vitals       PatientVitals[] @relation("BranchVitals")
  payments     BillPayment[]   @relation("BranchPayments")
  refunds      BillRefund[]    @relation("BranchRefunds")
  clinicalImages ClinicalImage[] @relation("BranchClinicalImages")
  caseNotes    CaseNote[]      @relation("BranchCaseNotes")
  consultations ConsultationRecord[] @relation("BranchConsultations")
  inventory    DrugInventory[] @relation("BranchInventory")
  movements    StockMovement[] @relation("BranchMovements")
  schedules    DoctorSchedule[] @relation("BranchSchedules")
  transfersOut        StockTransfer[]      @relation("TransfersOut")
  transfersIn         StockTransfer[]      @relation("TransfersIn")
  prescriptions       Prescription[]       @relation("BranchPrescriptions")
  investigations      InvestigationOrder[] @relation("BranchInvestigations")
  procedures          ProcedureSession[]   @relation("BranchProcedures")
  investigationResults InvestigationResult[] @relation("BranchInvestigationResults")
  investigationFiles   InvestigationFile[]   @relation("BranchInvestigationFiles")
  prescriptionItems    PrescriptionItem[]    @relation("BranchPrescriptionItems")
  billItems            BillItem[]            @relation("BranchBillItems")
  userAccess           UserBranchAccess[]    @relation("BranchUsers")
}

model UserBranchAccess {
  id        String   @id @default(uuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation("BranchUsers", fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}

model Department {
  id             String          @id @default(uuid())
  branchId       String
  name           String
  code           String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctorProfiles DoctorProfile[]
}

model Room {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  roomType  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model DoctorSchedule {
  id        String        @id @default(uuid())
  doctorId  String
  branchId  String
  dayOfWeek Int
  startTime DateTime      @db.Time(6)
  endTime   DateTime      @db.Time(6)
  shiftType String
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch    Branch        @relation("BranchSchedules", fields: [branchId], references: [id])
}

model ClinicSetting {
  id           String   @id @default(uuid())
  clinicId     String
  settingKey   String
  settingValue String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, settingKey])
}

model DoctorLeave {
  id        String        @id @default(uuid())
  doctorId  String
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  reason    String?
  status    LeaveStatus   @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model DoctorBlockedSlot {
  id        String        @id @default(uuid())
  doctorId  String
  branchId  String
  date      DateTime      @db.Date
  startTime DateTime      @db.Time(6)
  endTime   DateTime      @db.Time(6)
  reason    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Holiday {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  name        String
  isRecurring Boolean  @default(false)
  branchId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PatientAddress {
  id           String   @id @default(uuid())
  patientId    String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String   @default("India")
  zipCode      String?
  isPrimary    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientGuardian {
  id           String   @id @default(uuid())
  patientId    String
  name         String
  relationship String
  mobile       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientDocument {
  id             String   @id @default(uuid())
  patientId      String
  documentType   String
  documentNumber String?
  fileUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientFlag {
  id          String   @id @default(uuid())
  patientId   String
  flagType    String
  description String?
  colorCode   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientAllergy {
  id         String   @id @default(uuid())
  patientId  String
  allergen   String
  reaction   String?
  severity   Severity @default(MODERATE)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientHistory {
  id                 String   @id @default(uuid())
  patientId          String   @unique
  pastMedical        String?
  pastSurgical       String?
  familyHistory      String?
  personalHistory    String?
  obstetricHistory   String?
  currentMedications String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientInsurance {
  id             String    @id @default(uuid())
  patientId      String
  provider       String
  policyNumber   String
  validFrom      DateTime? @db.Date
  validTill      DateTime? @db.Date
  coverageAmount Decimal?  @db.Decimal(10, 2)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientNote {
  id          String   @id @default(uuid())
  patientId   String
  noteText    String
  noteType    String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Appointment {
