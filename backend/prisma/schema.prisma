  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  items          StockTransferItem[]

  sourceBranch   Branch               @relation("TransfersOut", fields: [sourceBranchId], references: [id])
  destBranch     Branch               @relation("TransfersIn", fields: [destBranchId], references: [id])
  requestedBy    User                 @relation("TransfersRequested", fields: [requestedById], references: [id])
  approvedBy     User?                @relation("TransfersApproved", fields: [approvedById], references: [id])
  dispatchedBy   User?                @relation("TransfersDispatched", fields: [dispatchedById], references: [id])
  receivedBy     User?                @relation("TransfersReceived", fields: [receivedById], references: [id])
}

model StockTransferItem {
  id              String         @id @default(uuid())
  transferId      String
  drugId          String
  batchId         String?
  requestedQty    Int
  dispatchedQty   Int            @default(0)
  receivedQty     Int            @default(0)
  status          StockTransferItemStatus @default(PENDING)

  transfer        StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  drug            Drug           @relation(fields: [drugId], references: [id])
  batch           DrugBatch?     @relation(fields: [batchId], references: [id])
}

enum StockTransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  REJECTED
  PARTIAL
}

enum StockTransferItemStatus {
  PENDING
  DISPATCHED
  RECEIVED
  DAMAGED
  MISSING
}

model PatientAuth {
  id             String    @id @default(uuid())
  patientId      String    @unique
  otp            String?
  otpExpires     DateTime?
  lastLogin      DateTime?
  mobileVerified Boolean   @default(false)
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model CommunicationLog {
  id           String             @id @default(uuid())
  recipient    String
  channel      String             // SMS, EMAIL, WHATSAPP, IN_APP
  payload      String             @db.Text
  templateName String?
  status       String             @default("PENDING") // PENDING, SENT, FAILED
  errorMessage String?            @db.Text
  patientId    String?
  userId       String?
  metadata     Json?
  createdAt    DateTime           @default(now())
  deliveredAt  DateTime?
  patient      Patient?           @relation(fields: [patientId], references: [id])
  user         User?              @relation(fields: [userId], references: [id])
}

model InAppNotification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  severity  String   @default("MILD") // MILD, MODERATE, SEVERE, CRITICAL
  status    String   @default("UNREAD") // UNREAD, READ, ARCHIVED
  isRead    Boolean  @default(false)
  readAt    DateTime?
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model HipaaAuditLog {
  id           String    @id @default(uuid())
  userId       String?
  role         String?
  branchId     String?
  patientId    String?
  actionType   String
  module       String
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime  @default(now())
  entityType   String?
  entityId     String?
  details      String?

  @@index([patientId])
  @@index([userId])
  @@index([branchId])
  @@index([actionType])
  @@index([timestamp])
}

model PatientConsent {
  id            String    @id @default(uuid())
  patientId     String
  consentType   String    // TREATMENT, DATA_SHARING, INSURANCE, etc.
  status        String    @default("ACTIVE") // ACTIVE, WITHDRAWN
  signedAt      DateTime  @default(now())
  withdrawnAt   DateTime?
  ipAddress     String?
  userAgent     String?
  signatureText String?

  @@index([patientId])
}
