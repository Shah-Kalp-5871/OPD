// =================================================================
// PHASE 24 BATCH 1: Predictive Risk Intelligence
// =================================================================
model PatientRiskProfile {
  id                String           @id @default(uuid())
  tenantId          String
  patientId         String           @unique
  overallRiskScore  Float            @default(0.0) // 0-100
  deteriorationRisk Float            @default(0.0)
  sepsisRisk        Float            @default(0.0)
  readmissionProb   Float            @default(0.0)
  mortalityRisk     Float            @default(0.0)
  icuEscalationProb Float            @default(0.0)
  noShowProb        Float            @default(0.0)
  adherenceProb     Float            @default(100.0)
  lastCalculatedAt  DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  predictions       RiskPrediction[]
  alerts            AiAlert[]
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model RiskPrediction {
  id                  String             @id @default(uuid())
  tenantId            String
  riskProfileId       String
  predictionType      String // SEPSIS, DETERIORATION, READMISSION
  score               Float
  confidence          Float
  triggerEvidence     Json // e.g. [{ "metric": "HR", "value": 120 }]
  contributingFactors Json
  explainability      Json // metadata for explainability layer
  createdAt           DateTime           @default(now())
  riskProfile         PatientRiskProfile @relation(fields: [riskProfileId], references: [id], onDelete: Cascade)
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AiAlert {
  id            String             @id @default(uuid())
  tenantId      String
  riskProfileId String
  alertType     String // CRITICAL, HIGH, MODERATE, LOW
  message       String
  isResolved    Boolean            @default(false)
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime           @default(now())
  riskProfile   PatientRiskProfile @relation(fields: [riskProfileId], references: [id], onDelete: Cascade)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// =================================================================
// PHASE 24 BATCH 2: Autonomous Hospital Workflow Orchestration
// =================================================================
model WorkflowRule {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  triggerType String // E.g., 'HIGH_RISK_ALERT', 'LAB_RESULT_ABNORMAL'
  conditions  Json // Evaluated conditions
  actions     Json // Actions to orchestrate (e.g., 'ASSIGN_DOCTOR', 'ROUTE_TO_ICU')
