// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPTION
  DOCTOR
  NURSING
  MEDICAL
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile relations
  adminProfile     AdminProfile?
  receptionProfile ReceptionProfile?
  doctorProfile    DoctorProfile?
  nurseProfile     NurseProfile?
  medicalProfile   MedicalProfile?

  // Medical relations
  vitalsTaken      PatientVitals[]
  doctorCases      PatientCase[]
}

// ---------------------------------------------------------
// Profile Tables (1:1 with User)
// ---------------------------------------------------------

model AdminProfile {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // Placeholder for admin-specific data
  notes String?
}

model ReceptionProfile {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  salary       Float @default(0.0)
  overtimeRate Float @default(0.0)
}

model DoctorProfile {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  specialization  String?
  consultationFee Float    @default(0.0)
  licenseNumber   String?  @unique
  
  availableDays   String[] @default([])
  morningStart    String?
  morningEnd      String?
  eveningStart    String?
  eveningEnd      String?
  appointmentGap  Int      @default(10)
  slotDuration    Int      @default(15)
}

model NurseProfile {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  department   String?
  salary       Float   @default(0.0)
  overtimeRate Float   @default(0.0)
}

model MedicalProfile {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  isPharmacist Boolean @default(false)
  salary       Float   @default(0.0)
  overtimeRate Float   @default(0.0)
}

// ---------------------------------------------------------
// Patient Foundation Models
// ---------------------------------------------------------

model Patient {
  id                    String           @id @default(uuid())
  mrdNumber             String           @unique
  firstName             String
  middleName            String?
  lastName              String
  mobile                String           @unique
  gender                String
  profileCompletionStatus Int             @default(20)
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  profile               PatientProfile?
  vitals                PatientVitals[]
  cases                 PatientCase[]
}

model PatientProfile {
  id               String   @id @default(uuid())
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId        String   @unique

  dob              DateTime?
  age              Int?
  bloodGroup       String?
  address          String?
  city             String?
  state            String?
  occupation       String?
  maritalStatus    String?
  allergies        String?
  emergencyContact String?
  notes            String?
  photo            String?
}

model PatientVitals {
  id            String   @id @default(uuid())
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  
  caseId        String?
  
  height        Float?
  weight        Float?
  bmi           Float?
  bloodPressure String?
  pulse         Int?
  temperature   Float?
  spo2          Int?
  
  takenBy       User?    @relation(fields: [takenById], references: [id])
  takenById     String?
  takenAt       DateTime @default(now())
}

model PatientCase {
  id          String   @id @default(uuid())
  caseNumber  String   @unique
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId   String
  
  doctor      User?    @relation(fields: [doctorId], references: [id])
  doctorId    String?
  
  visitType   String?  // e.g., CONSULTATION, REVIEW, EMERGENCY
  priority    String   @default("NORMAL") // NORMAL, URGENT, EMERGENCY
  complaint   String?  // Chief complaint
  
  visitDate   DateTime @default(now())
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}

