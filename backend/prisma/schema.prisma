  performedBy    User          @relation(fields: [performedById], references: [id])
  branch         Branch        @relation("BranchMovements", fields: [branchId], references: [id])

  @@index([inventoryId])
  @@index([batchId])
  @@index([movementType])
  @@index([createdAt])
  @@index([performedById])
  @@index([referenceId])
  @@index([branchId])
}

