  @@index([inventoryId])
  @@index([expiryDate])
  @@index([batchNumber])
  @@index([isActive])
  @@index([isExpired])
  @@index([stockQuantity])
}

model StockMovement {
  id             String        @id @default(uuid())
  inventoryId    String
