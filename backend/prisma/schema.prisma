  totalPatients    Int
  careGaps         Json // e.g., ["Missed HbA1c", "No Retinal Exam"]
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// =================================================================
// PHASE 24 BATCH 6: Knowledge Copilot & RAG
// =================================================================
model RagDocument {
  id         String   @id @default(uuid())
  tenantId   String
  title      String
  content    String   @db.Text
  category   String // e.g., 'CLINICAL_PROTOCOL', 'DRUG_INTERACTION'
  vectorId   String? // ID referring to vector DB (if applicable)
  uploadedAt DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CopilotInteraction {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String // The clinician asking the question
  query     String   @db.Text
  response  String   @db.Text
  citations Json? // Array of RagDocument IDs or titles referenced
  timestamp DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// =================================================================
// PHASE 24 BATCH 7: MLOps & AI Governance
// =================================================================
model ModelRegistry {
  id            String        @id @default(uuid())
  tenantId      String
  modelName     String // e.g., 'SepsisPredictor', 'RevenueForecaster'
  version       String // e.g., 'v1.2.0'
  status        String // ACTIVE, DEPRECATED, SHADOW
  accuracyScore Float // 0 - 100
  deployedAt    DateTime      @default(now())
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driftMetrics  DriftMetric[]
}

model DriftMetric {
  id            String        @id @default(uuid())
  tenantId      String
  modelId       String
  driftScore    Float // Magnitude of drift detected
  featureDrifts Json // e.g., { "age_distribution": 0.15 }
  evaluatedAt   DateTime      @default(now())
  model         ModelRegistry @relation(fields: [modelId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// PHASE 25 — ENTERPRISE ERP / HRMS / SUPPLY CHAIN
// ─────────────────────────────────────────────

// 25.1 HRMS

model HrmsDepartment {
  id        String     @id @default(uuid())
  tenantId  String
  branchId  String?
  name      String
  code      String
  headId    String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]
  shifts    Shift[]
}

model Designation {
  id        String     @id @default(uuid())
  tenantId  String
  title     String
  grade     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]
}

model Employee {
  id                String                     @id @default(uuid())
  tenantId          String
  branchId          String?
  employeeCode      String
  firstName         String
  lastName          String
  email             String
  phone             String?
  dateOfBirth       DateTime?
  gender            String?
  address           Json?
  departmentId      String?
  designationId     String?
  joiningDate       DateTime
  exitDate          DateTime?
  employmentType    String                     @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN
  status            String                     @default("ACTIVE") // ACTIVE, INACTIVE, ON_LEAVE, TERMINATED
  profileImageUrl   String?
  emergencyContacts EmployeeEmergencyContact[]
  documents         EmployeeDocument[]
  certifications    EmployeeCertification[]
  attendanceRecords EmployeeAttendance[]
  shiftAssignments  ShiftAssignment[]
  leaveRequests     LeaveRequest[]
  payrollRecords    PayrollRecord[]
  salaryStructure   SalaryStructure?
  department        HrmsDepartment?            @relation(fields: [departmentId], references: [id])
  designation       Designation?               @relation(fields: [designationId], references: [id])
  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([tenantId, employeeCode])
}

model EmployeeEmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String
  name         String
  relationship String
  phone        String
  email        String?
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeDocument {
  id           String    @id @default(uuid())
  employeeId   String
  documentType String // AADHAR, PAN, PASSPORT, RESUME, CONTRACT, etc.
  documentUrl  String
  uploadedAt   DateTime  @default(now())
  expiryDate   DateTime?
  verified     Boolean   @default(false)
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeCertification {
  id             String    @id @default(uuid())
  employeeId     String
  certName       String
  issuingBody    String
  issueDate      DateTime
  expiryDate     DateTime?
  certificateUrl String?
  status         String    @default("VALID") // VALID, EXPIRED, EXPIRING_SOON
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
}

model EmployeeAttendance {
  id            String    @id @default(uuid())
  tenantId      String
  employeeId    String
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  status        String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, WFH, HOLIDAY
  hoursWorked   Float?
  overtimeHours Float?
  notes         String?
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@unique([tenantId, employeeId, date])
}

// 25.2 WORKFORCE SCHEDULING

model Shift {
  id            String            @id @default(uuid())
  tenantId      String
  branchId      String?
  departmentId  String?
  name          String // MORNING, EVENING, NIGHT, ROTATIONAL
  startTime     String // HH:MM format
  endTime       String
  durationHours Float
  isActive      Boolean           @default(true)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department    HrmsDepartment?   @relation(fields: [departmentId], references: [id])
  assignments   ShiftAssignment[]
  createdAt     DateTime          @default(now())
}

model ShiftAssignment {
  id         String   @id @default(uuid())
  tenantId   String
  shiftId    String
  employeeId String
  date       DateTime
  status     String   @default("SCHEDULED") // SCHEDULED, COMPLETED, SWAPPED, CANCELLED
  notes      String?
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model ShiftSwapRequest {
  id           String    @id @default(uuid())
  tenantId     String
  requesterId  String
  targetId     String
  originalDate DateTime
  targetDate   DateTime
  reason       String?
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy   String?
  resolvedAt   DateTime?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

model LeaveRequest {
  id         String    @id @default(uuid())
  tenantId   String
  employeeId String
  leaveType  String // ANNUAL, SICK, CASUAL, MATERNITY, EMERGENCY
  startDate  DateTime
  endDate    DateTime
  days       Float
  reason     String?
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedBy String?
  approvedAt DateTime?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}

model StaffingForecast {
  id                   String   @id @default(uuid())
  tenantId             String
  branchId             String?
  forecastDate         DateTime
  department           String
  requiredStaff        Int
  predictedPatientLoad Int
  riskLevel            String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  aiRecommendations    Json?
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
}

// 25.3 PAYROLL

model SalaryStructure {
  id            String   @id @default(uuid())
  tenantId      String
  employeeId    String   @unique
  basicSalary   Float
  hra           Float    @default(0)
  allowances    Json? // { "transport": 2000, "medical": 1500 }
  deductions    Json? // { "pf": 1800, "esi": 400 }
  effectiveFrom DateTime
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PayrollCycle {
  id              String          @id @default(uuid())
  tenantId        String
  month           String // YYYY-MM
  status          String          @default("DRAFT") // DRAFT, PROCESSING, APPROVED, PAID
  totalGrossPay   Float           @default(0)
  totalDeductions Float           @default(0)
  totalNetPay     Float           @default(0)
  processedAt     DateTime?
  approvedBy      String?
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records         PayrollRecord[]
  createdAt       DateTime        @default(now())

  @@unique([tenantId, month])
}

model PayrollRecord {
  id              String       @id @default(uuid())
  tenantId        String
  cycleId         String
  employeeId      String
  basicPay        Float
  allowances      Float        @default(0)
  overtime        Float        @default(0)
  grossPay        Float
  taxDeduction    Float        @default(0)
  pfDeduction     Float        @default(0)
  otherDeductions Float        @default(0)
  netPay          Float
  payslipUrl      String?
  status          String       @default("PENDING") // PENDING, PAID, HELD
  cycle           PayrollCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
}

model EmployeeBenefit {
  id            String    @id @default(uuid())
  tenantId      String
  employeeId    String
  benefitType   String // HEALTH_INSURANCE, LIFE_INSURANCE, GRATUITY, BONUS
  value         Float
  description   String?
  effectiveDate DateTime
  expiryDate    DateTime?
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
}

model ReimbursementClaim {
  id          String    @id @default(uuid())
  tenantId    String
  employeeId  String
  category    String // TRAVEL, MEDICAL, MEAL, EQUIPMENT
  amount      Float
  description String
  receiptUrl  String?
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  approvedBy  String?
  approvedAt  DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

// 25.4 PROCUREMENT & SUPPLY CHAIN

model Vendor {
  id               String             @id @default(uuid())
  tenantId         String
  name             String
  contactPerson    String?
  email            String?
  phone            String?
  address          Json?
  category         String? // PHARMACEUTICAL, EQUIPMENT, CONSUMABLE, LAB_REAGENT
  reliabilityScore Float? // AI-generated 0-100
  isActive         Boolean            @default(true)
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders   PurchaseOrder[]
  bioVendor        BiomedicalVendor[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  tenantId      String
  branchId      String?
  vendorId      String
  poNumber      String
  status        String              @default("DRAFT") // DRAFT, SENT, CONFIRMED, RECEIVED, CANCELLED
  totalAmount   Float               @default(0)
  expectedDate  DateTime?
  deliveredDate DateTime?
  notes         String?
  approvedBy    String?
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([tenantId, poNumber])
}

model PurchaseOrderItem {
  id         String        @id @default(uuid())
  poId       String
  itemName   String
  itemCode   String?
  quantity   Float
  unitPrice  Float
  totalPrice Float
  unit       String?
  received   Float         @default(0)
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
}

model GoodsReceipt {
  id               String        @id @default(uuid())
  tenantId         String
  poId             String
  grnNumber        String
  receivedBy       String?
  receivedAt       DateTime      @default(now())
  status           String        @default("RECEIVED") // RECEIVED, PARTIAL, REJECTED
  qualityCheckDone Boolean       @default(false)
  notes            String?
  po               PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, grnNumber])
}

model Warehouse {
  id        String              @id @default(uuid())
  tenantId  String
  branchId  String?
  name      String
  location  String?
  capacity  Float?
  isActive  Boolean             @default(true)
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stocks    InventoryStock[]
  movements InventoryMovement[]
  createdAt DateTime            @default(now())
}

model InventoryStock {
  id           String              @id @default(uuid())
  tenantId     String
  warehouseId  String
  itemName     String
  itemCode     String
  category     String?
  quantity     Float               @default(0)
  reorderLevel Float               @default(0)
  unitCost     Float?
  unit         String?
  expiryDate   DateTime?
  lastUpdated  DateTime            @updatedAt
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements    InventoryMovement[]

  @@unique([tenantId, warehouseId, itemCode])
}

model InventoryMovement {
  id           String         @id @default(uuid())
  tenantId     String
  warehouseId  String
  stockId      String
  movementType String // IN, OUT, TRANSFER, ADJUSTMENT
  quantity     Float
  referenceId  String? // PO or GRN ID
  performedBy  String?
  notes        String?
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id])
  stock        InventoryStock @relation(fields: [stockId], references: [id])
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
}

// 25.5 PHARMACY INTELLIGENCE

model MedicationInventory {
  id             String            @id @default(uuid())
  tenantId       String
  branchId       String?
  medicationName String
  genericName    String?
  category       String?
  strength       String?
  unit           String?
  totalQty       Float             @default(0)
  reorderQty     Float             @default(0)
  unitCost       Float?
  isControlled   Boolean           @default(false)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches        MedicationBatch[]
  dispenseAudits DispenseAudit[]
  expiryAlerts   ExpiryAlert[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model MedicationBatch {
  id             String              @id @default(uuid())
  tenantId       String
  medicationId   String
  batchNumber    String
  quantity       Float
  expiryDate     DateTime
  manufacturedBy String?
  receivedAt     DateTime            @default(now())
  status         String              @default("ACTIVE") // ACTIVE, EXPIRED, RECALLED, DEPLETED
  medication     MedicationInventory @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ControlledSubstanceLog {
  id           String   @id @default(uuid())
  tenantId     String
  medicationId String
  action       String // RECEIVED, DISPENSED, WASTED, RETURNED, COUNTED
  quantity     Float
  patientId    String?
  prescriberId String?
  witnessId    String?
  performedBy  String
  notes        String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model DispenseAudit {
  id             String              @id @default(uuid())
  tenantId       String
  medicationId   String
  quantity       Float
  dispensedTo    String?
  dispensedBy    String
  prescriptionId String?
  anomalyFlag    Boolean             @default(false)
  anomalyReason  String?
  medication     MedicationInventory @relation(fields: [medicationId], references: [id])
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
}

model ExpiryAlert {
  id            String              @id @default(uuid())
  tenantId      String
  medicationId  String
  batchId       String?
  expiryDate    DateTime
  daysRemaining Int
  alertLevel    String              @default("INFO") // INFO, WARNING, CRITICAL
  resolved      Boolean             @default(false)
  medication    MedicationInventory @relation(fields: [medicationId], references: [id])
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
}

// 25.6 BIOMEDICAL ASSET MANAGEMENT

model BiomedicalAsset {
  id              String              @id @default(uuid())
  tenantId        String
  branchId        String?
  assetTag        String
  name            String
  category        String // VENTILATOR, MONITOR, ULTRASOUND, XRAY_MACHINE, etc.
  manufacturer    String?
  model           String?
  serialNumber    String?
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  location        String?
  status          String              @default("OPERATIONAL") // OPERATIONAL, UNDER_MAINTENANCE, FAULTY, DECOMMISSIONED
  utilizationRate Float? // 0–100
  lastServiceDate DateTime?
  nextServiceDue  DateTime?
  vendor          BiomedicalVendor?   @relation(fields: [vendorId], references: [id])
  vendorId        String?
  maintenanceLogs AssetMaintenance[]
  calibrations    CalibrationRecord[]
  downtimes       AssetDowntime[]
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([tenantId, assetTag])
}

model BiomedicalVendor {
  id         String            @id @default(uuid())
  tenantId   String
  vendorId   String
  speciality String? // AMC, CALIBRATION, REPAIRS
  slaHours   Int?
  vendor     Vendor            @relation(fields: [vendorId], references: [id])
  assets     BiomedicalAsset[]
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AssetMaintenance {
  id          String          @id @default(uuid())
  tenantId    String
  assetId     String
  type        String // PREVENTIVE, CORRECTIVE, CALIBRATION
  performedBy String?
  cost        Float?
  description String?
  nextDue     DateTime?
  completedAt DateTime        @default(now())
  asset       BiomedicalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CalibrationRecord {
  id              String          @id @default(uuid())
  tenantId        String
  assetId         String
  calibratedBy    String?
  standard        String?
  result          String          @default("PASS") // PASS, FAIL, CONDITIONAL
  certificate     String?
  nextCalibration DateTime?
  calibratedAt    DateTime        @default(now())
  asset           BiomedicalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AssetDowntime {
  id          String          @id @default(uuid())
  tenantId    String
  assetId     String
  reason      String
  startedAt   DateTime
  resolvedAt  DateTime?
  durationHrs Float?
  impact      String? // LOW, MEDIUM, HIGH, CRITICAL
  asset       BiomedicalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// 25.7 FACILITY & MAINTENANCE OPS

model Facility {
  id                 String              @id @default(uuid())
  tenantId           String
  branchId           String?
  name               String
  type               String // WARD, OT, ICU, PHARMACY, LAB, OPD, ADMIN
  floor              String?
  capacity           Int?
  status             String              @default("OPERATIONAL")
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenanceTickets MaintenanceTicket[]
  housekeepingTasks  HousekeepingTask[]
  energyReadings     EnergyConsumption[]
  createdAt          DateTime            @default(now())
}

model MaintenanceTicket {
  id          String    @id @default(uuid())
  tenantId    String
  facilityId  String
  title       String
  description String?
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, ESCALATED
  assignedTo  String?
  resolvedAt  DateTime?
  slaDeadline DateTime?
  cost        Float?
  facility    Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model HousekeepingTask {
  id          String    @id @default(uuid())
  tenantId    String
  facilityId  String
  taskType    String // CLEANING, DISINFECTION, LINEN_CHANGE, WASTE_DISPOSAL
  assignedTo  String?
  scheduledAt DateTime
  completedAt DateTime?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, DONE, SKIPPED
  notes       String?
  facility    Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model EnergyConsumption {
  id         String   @id @default(uuid())
  tenantId   String
  facilityId String
  metricType String // ELECTRICITY, WATER, GAS, HVAC
  value      Float
  unit       String // kWh, liters, m3
  recordedAt DateTime @default(now())
  anomaly    Boolean  @default(false)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model IncidentReport {
  id           String    @id @default(uuid())
  tenantId     String
  branchId     String?
  title        String
  description  String
  incidentType String // FALL, EQUIPMENT_FAILURE, FIRE, SECURITY, MEDICATION_ERROR, OTHER
  severity     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  location     String?
  reportedBy   String
  assignedTo   String?
  status       String    @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, CLOSED
  resolution   String?
  resolvedAt   DateTime?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

