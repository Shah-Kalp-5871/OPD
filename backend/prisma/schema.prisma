// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPTION
  DOCTOR
  NURSING
  MEDICAL
}

enum CaseStage {
  RECEPTION
  NURSING
  DOCTOR
  BILLING
  PHARMACY
  COMPLETED
}

enum QueueStatus {
  WAITING
  CALLING
  IN_SESSION
  BILLING_PENDING
  NO_RESPONSE
  CANCELLED
  COMPLETED
}

enum QueueType {
  OPD
  FOLLOWUP
  EMERGENCY
  PROCEDURE
  LAB
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  mobile    String?
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile relations
  adminProfile     AdminProfile?
  receptionProfile ReceptionProfile?
  doctorProfile    DoctorProfile?
  nurseProfile     NurseProfile?
  medicalProfile   MedicalProfile?

  // Medical relations
  vitalsTaken      PatientVitals[]
  doctorCases      PatientCase[]
  
  // Queue & Session relations
  assignedQueues   QueueEntry[]
  doctorSessions   VisitSession[]
  performedActions QueueHistory[]
  createdBills     Bill[]         @relation("BillCreatedBy")
  doctorConsultations ConsultationRecord[] @relation("DoctorConsultations")
}


// ---------------------------------------------------------
// Profile Tables (1:1 with User)
// ---------------------------------------------------------

model AdminProfile {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // Placeholder for admin-specific data
  notes String?
}

model ReceptionProfile {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  salary       Float @default(0.0)
  overtimeRate Float @default(0.0)
}

model DoctorProfile {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  specialization  String?
  consultationFee Float    @default(0.0)
  licenseNumber   String?  @unique
  
  availableDays   String[] @default([])
  morningStart    String?
  morningEnd      String?
  eveningStart    String?
  eveningEnd      String?
  appointmentGap  Int      @default(10)
  slotDuration    Int      @default(15)
}

model NurseProfile {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  department   String?
  salary       Float   @default(0.0)
  overtimeRate Float   @default(0.0)
}

model MedicalProfile {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  isPharmacist Boolean @default(false)
  salary       Float   @default(0.0)
  overtimeRate Float   @default(0.0)
}

// ---------------------------------------------------------
// Patient Foundation Models
// ---------------------------------------------------------

model Patient {
  id                    String           @id @default(uuid())
  mrdNumber             String           @unique
  firstName             String
  middleName            String?
  lastName              String
  mobile                String           @unique
  gender                String
  profileCompletionStatus Int             @default(20)
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  profile               PatientProfile?
  vitals                PatientVitals[]
  cases                 PatientCase[]
  queueEntries          QueueEntry[]
  bills                 Bill[]
}

model PatientProfile {
  id               String   @id @default(uuid())
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId        String   @unique

  dob              DateTime?
  age              Int?
  bloodGroup       String?
  address          String?
  city             String?
  state            String?
  occupation       String?
  maritalStatus    String?
  allergies        String?
  emergencyContact String?
  notes            String?
  photo            String?
}

model PatientVitals {
  id            String   @id @default(uuid())
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  
  caseId        String?
  
  height        Float?
  weight        Float?
  bmi           Float?
  bloodPressure String?
  pulse         Int?
  temperature   Float?
  spo2          Int?
  
  takenBy       User?    @relation(fields: [takenById], references: [id])
  takenById     String?
  takenAt       DateTime @default(now())
}

model PatientCase {
  id          String   @id @default(uuid())
  caseNumber  String   @unique
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId   String
  
  doctor      User?    @relation(fields: [doctorId], references: [id])
  doctorId    String?
  
  visitType   String?  // e.g., CONSULTATION, REVIEW, EMERGENCY
  priority    String   @default("NORMAL") // NORMAL, URGENT, EMERGENCY
  complaint   String?  // Chief complaint
  
  visitDate   DateTime @default(now())
  status      String   @default("OPEN")
  stage       CaseStage @default(RECEPTION)
  createdAt   DateTime @default(now())

  // New relations
  queueEntry   QueueEntry?
  sessions     VisitSession[]
  bill         Bill?
  consultation ConsultationRecord?
}


model QueueEntry {
  id            String      @id @default(uuid())
  tokenDisplay  String      @unique // e.g., "DR-SHAH-014"
  tokenNumber   Int         // For sorting
  queueType     QueueType   @default(OPD)
  status        QueueStatus @default(WAITING)
  priority      String      @default("NORMAL")
  
  // Relations
  case          PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId        String      @unique
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  doctor        User?       @relation(fields: [doctorId], references: [id])
  doctorId      String?
  
  checkInTime   DateTime    @default(now())
  callCount     Int         @default(0)
  history       QueueHistory[]
}

model VisitSession {
  id          String    @id @default(uuid())
  case        PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  doctor      User      @relation(fields: [doctorId], references: [id])
  doctorId    String
  
  startTime   DateTime  @default(now())
  endTime     DateTime?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, SUSPENDED
  
  consultation ConsultationRecord?
}


model QueueHistory {
  id            String      @id @default(uuid())
  queueEntry    QueueEntry  @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  queueEntryId  String
  action        String      // e.g., "CHECK_IN", "CALL", "NO_RESPONSE"
  fromStatus    QueueStatus?
  toStatus      QueueStatus
  performedBy   User        @relation(fields: [performedById], references: [id])
  performedById String
  timestamp     DateTime    @default(now())
}

model Bill {
  id            String      @id @default(uuid())
  billNumber    String      @unique // e.g., "RCP-0413-003"
  
  case          PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId        String      @unique
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  
  grossAmount   Float       @default(0.0)
  discountTotal Float       @default(0.0)
  netAmount     Float       @default(0.0)
  paidAmount    Float       @default(0.0)
  balanceAmount Float       @default(0.0)
  
  paymentStatus String      @default("PENDING") // PENDING, PARTIAL, PAID, FOC
  paymentMode   String?     // CASH, CARD, UPI, ONLINE
  transactionId String?
  
  billingDate   DateTime    @default(now())
  paidAt        DateTime?
  
  items         BillItem[]
  
  createdBy     User?       @relation("BillCreatedBy", fields: [createdById], references: [id])
  createdById   String?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model BillItem {
  id            String   @id @default(uuid())
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId        String
  
  serviceName   String   // e.g., "Consultation", "Procedure: Diode"
  description   String?
  quantity      Int      @default(1)
  unitPrice     Float    @default(0.0)
  discount      Float    @default(0.0) // Percentage or fixed? Let's say percentage for now
  totalPrice    Float    @default(0.0)
  
  // Link to specific procedure session if applicable
  // sessionId  String?
  
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------
// Consultation & EMR Models
// ---------------------------------------------------------

model ConsultationRecord {
  id              String           @id @default(uuid())
  case            PatientCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId          String           @unique
  
  session         VisitSession?    @relation(fields: [sessionId], references: [id])
  sessionId       String?          @unique
  
  doctor          User             @relation("DoctorConsultations", fields: [doctorId], references: [id])
  doctorId        String
  
  status          String           @default("DRAFT") // DRAFT, FINALIZED
  
  complaint       ComplaintEntry?
  history         ClinicalHistory?
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ComplaintEntry {
  id                   String             @id @default(uuid())
  consultation         ConsultationRecord @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  consultationId       String             @unique
  
  chiefComplaint       String?
  duration             Int?
  durationType         String?            // DAYS, WEEKS, MONTHS, YEARS
  severity             String?            // MILD, MODERATE, SEVERE
  onset                String?            // SUDDEN, GRADUAL
  aggravatingFactors   String?
  relievingFactors     String?
  
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model ClinicalHistory {
  id                   String             @id @default(uuid())
  consultation         ConsultationRecord @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  consultationId       String             @unique
  
  pastHistory          String?
  personalHistory      String?
  surgicalHistory      String?
  familyHistory        String?
  obstetricHistory     String?            // For female patients
  
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}
