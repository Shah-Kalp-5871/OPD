  transactionId String? // Link to Billing or Claim
  alertType     String // 'UPCODING', 'DUPLICATE_CLAIM', 'ANOMALOUS_PRICING'
  riskScore     Float // 0 - 100
  evidence      Json // e.g. { "cptCode": "99214", "avgTime": "5m", "flag": "Time mismatch" }
  status        String   @default("INVESTIGATING") // INVESTIGATING, CONFIRMED, CLEARED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// =================================================================
// PHASE 24 BATCH 5: Population Health & Epidemiology
