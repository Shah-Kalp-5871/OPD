model WearableDevice {
  id           String    @id @default(uuid())
  patientId    String
  provider     String // APPLE_HEALTH, GOOGLE_FIT, BP_MONITOR, GLUCOSE_MONITOR
  deviceName   String?
  deviceUuid   String? // unique identifier of the physical device
  accessToken  String? // encrypted/hashed token if oauth based
  refreshToken String? // encrypted/hashed token
  tokenExpires DateTime?
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient  Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  metrics  HealthMetric[]
  syncLogs DeviceSyncLog[]

  @@unique([patientId, provider, deviceUuid])
  @@index([patientId])
  @@index([provider])
}

model HealthMetric {
  id          String   @id @default(uuid())
  patientId   String
  deviceId    String?
  metricType  String // HEART_RATE, BLOOD_PRESSURE, SPO2, GLUCOSE, SLEEP, STEPS
  value       Float // numeric primary value
  valueString String? // secondary text value (e.g. "120/80" for BP)
  unit        String? // bpm, mmHg, %, mg/dL, hrs, steps
  timestamp   DateTime // normalized timestamp of reading
  timezone    String   @default("UTC")
  metadata    Json? // custom fields like activity, intensity, sleep state
  createdAt   DateTime @default(now())

  patient Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  device  WearableDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([patientId, metricType, timestamp])
  @@index([patientId, timestamp])
  @@index([deviceId])
}

model DeviceSyncLog {
  id              String    @id @default(uuid())
  deviceId        String
  status          String // SUCCESS, FAILED
  metricsCount    Int       @default(0)
  errorReason     String?   @db.Text
  syncWindowStart DateTime?
  syncWindowEnd   DateTime?
  createdAt       DateTime  @default(now())

  device WearableDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([createdAt])
}

model ApiClient {
  id                 String    @id @default(uuid())
  name               String
  clientId           String    @unique
  clientSecret       String // hashed secret
  apiKey             String?   @unique // hashed api key if using direct API keys
  apiKeyPrefix       String? // prefix e.g., mf_live_
  apiKeyActive       Boolean   @default(true)
  scopes             String[] // e.g. ["appointments:read", "patients:read"]
  environment        String    @default("production") // sandbox, production
  isActive           Boolean   @default(true)
  tenantId           String? // SaaS tenant isolation
  branchId           String? // optional single-branch scope
  rateLimitPerMinute Int       @default(100)
  monthlyQuota       Int       @default(100000)
  monthlyUsageCount  Int       @default(0)
  usageResetAt       DateTime?
  lastUsedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  webhooks         ApiWebhookSubscription[]
  auditLogs        ApiAuditLog[]
  oauthTokens      OAuthToken[]
  usageRecords     ApiUsageRecord[]
  monthlySummaries ApiUsageMonthlySummary[]
  tenant           Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?                  @relation("BranchApiClients", fields: [branchId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([tenantId])
  @@index([branchId])
}

model ApiUsageRecord {
  id            String   @id @default(uuid())
  clientId      String
  tenantId      String?
  endpoint      String
  method        String
  statusCode    Int
  durationMs    Int
  responseBytes Int      @default(0)
  createdAt     DateTime @default(now())

  client ApiClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([tenantId, createdAt])
  @@index([endpoint])
}

model ApiUsageMonthlySummary {
  id            String   @id @default(uuid())
  clientId      String
  tenantId      String?
  year          Int
  month         Int
  totalRequests Int      @default(0)
  totalBytes    BigInt   @default(0)
  avgDurationMs Float    @default(0)
  endpointStats Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client ApiClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@unique([clientId, year, month])
  @@index([tenantId, year, month])
}

model OAuthToken {
