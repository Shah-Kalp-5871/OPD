  status        StockStatus     @default(IN_STOCK)
  location      String?
  updatedAt     DateTime        @updatedAt
  batches       DrugBatch[]
  drug          Drug            @relation(fields: [drugId], references: [id], onDelete: Cascade)
  movements     StockMovement[]
