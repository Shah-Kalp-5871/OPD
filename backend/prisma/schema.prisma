  doctorId         String
  status           String               @default("WAITING") // WAITING, ACTIVE, ENDED, FAILED
  roomId           String               @unique
  startedAt        DateTime?
  endedAt          DateTime?
  durationSeconds  Int?
  recordingUrl     String?
  recordingConsent Boolean              @default(false)
  turnCredential   Json?
  qualityMetrics   Json?
  createdAt        DateTime             @default(now())
