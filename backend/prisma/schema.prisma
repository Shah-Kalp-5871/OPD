  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
}

model BillingInvoice {
  id              String    @id @default(uuid())
  tenantId        String
  stripeInvoiceId String?   @unique
  invoiceNumber   String
  amountDue       Decimal   @db.Decimal(10, 2)
  amountPaid      Decimal   @db.Decimal(10, 2)
  currency        String    @default("USD")
  status          String // DRAFT, OPEN, PAID, UNCOLLECTIBLE, VOID
  hostedUrl       String?   @db.Text
  pdfUrl          String?   @db.Text
  dueDate         DateTime?
  paidAt          DateTime?
  periodStart     DateTime
  periodEnd       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions BillingTransaction[]

  @@index([tenantId])
  @@index([status])
}

model BillingTransaction {
  id              String   @id @default(uuid())
  invoiceId       String?
  tenantId        String
  stripePaymentId String?  @unique // stripe payment intent id
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("USD")
  status          String // SUCCESS, FAILED, PENDING
  paymentMethod   String? // CARD, ACH, etc.
  errorMessage    String?  @db.Text
  metadata        Json?
  createdAt       DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice BillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
}

model SubscriptionUsage {
  id           String   @id @default(uuid())
  tenantId     String
  metricName   String // SEATS_USED, AI_REQUESTS, API_CALLS
  currentUsage Int      @default(0)
  limitMax     Int      @default(0)
  resetAt      DateTime
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metricName])
  @@index([tenantId])
}

model FeatureUsageLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  featureKey String // TELEMEDICINE, AI_ANALYSIS, EXCEL_EXPORT
  actionCost Int      @default(1)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([featureKey])
  @@index([createdAt])
}

model ConsentArtifact {
  id              String         @id @default(uuid())
  tenantId        String
  patientId       String
  consentType     String // TREATMENT, DATA_SHARING, INSURANCE, etc.
  documentUrl     String?
  documentHash    String?
  signatureBase64 String?
  signedAt        DateTime       @default(now())
  deletedAt       DateTime?
  grants          ConsentGrant[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
}

model ConsentGrant {
  id              String              @id @default(uuid())
  tenantId        String
  patientId       String
  artifactId      String
  requesterSystem String // e.g. "epic-hub", "ndhm-portal"
  scopes          String[] // e.g. ["patient/*.read", "observation/*.read"]
  expiresAt       DateTime
  createdAt       DateTime            @default(now())
  deletedAt       DateTime?
  artifact        ConsentArtifact     @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  revocations     ConsentRevocation[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([artifactId])
}

model ConsentRevocation {
  id        String       @id @default(uuid())
  tenantId  String
  grantId   String
  revokedBy String // User ID or external system
  revokedAt DateTime     @default(now())
  reason    String?
  deletedAt DateTime?
  grant     ConsentGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([grantId])
}

model TerminologyConcept {
  id        String   @id @default(uuid())
  system    String // ICD-10, SNOMED, LOINC, RXNORM
  code      String
  display   String
  createdAt DateTime @default(now())

  @@unique([system, code])
  @@index([system])
}

model ExportJob {
  id        String    @id @default(uuid())
  tenantId  String
  status    String // PENDING, PROCESSING, COMPLETED, FAILED
  fileUrl   String?
  fileSize  Int?
  error     String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

