model SessionParticipant {
  id              String              @id @default(uuid())
  sessionId       String
  userId          String
  role            String // DOCTOR, PATIENT, NURSE, SPECIALIST
  joinedAt        DateTime            @default(now())
  leftAt          DateTime?
