model GlobalCommandCenterTelemetry {
  id              String   @id @default(uuid())
  tenantId        String
  branchId        String?
  platformHealth  String // HEALTHY, WARNING, CRITICAL
  activeIncidents Int      @default(0)
  throughputRate  Float    @default(0.0) // patients/hr
  revenueSummary  Decimal  @default(0.0) @db.Decimal(10, 2)
  securityAlerts  Int      @default(0)
  interopTraffic  Int      @default(0)
  cpuUsage        Float    @default(0.0)
  memoryUsage     Float    @default(0.0)
  createdAt       DateTime @default(now())
}

model QuantumOptimizationRecommendation {
  id              String    @id @default(uuid())
  tenantId        String
  branchId        String?
  targetAsset     String // STAFFING, BED_FLOW, QUEUE_BALANCING, APPOINTMENT_SPOTS
  recommendation  String
  rationale       String
  confidenceScore Float     @default(0.95)
  isSimulated     Boolean   @default(false)
  isApplied       Boolean   @default(false)
  appliedAt       DateTime?
  createdAt       DateTime  @default(now())
}

model SystemLiveIncident {
  id           String    @id @default(uuid())
  tenantId     String
  branchId     String?
  sourceModule String // SOC, TELEMETRY, INSURANCE, INTEROP
  title        String
  severity     String    @default("WARNING") // INFO, WARNING, CRITICAL
  status       String    @default("OPEN") // OPEN, MITIGATED, RESOLVED
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model OperationalTimelineEvent {
  id         String   @id @default(uuid())
  tenantId   String
  branchId   String?
  eventType  String // SECURITY, PATIENT, INFRASTRUCTURE, BILLING, INTEROP, AI_ESCALATION
  severity   String   @default("INFO") // INFO, WARNING, CRITICAL
  message    String
  metadata   Json?
  regionName String   @default("GLOBAL")
  createdAt  DateTime @default(now())
}
